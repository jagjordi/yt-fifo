{
  "manifest_version": 3,
  "name": "yt-fifo: play on home audio",
  "version": "0.1.0",
  "description": "Right-click a YouTube video to play it now or queue it on a yt-fifo server (YouTube audio into Snapcast).",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["contextMenus", "storage", "notifications"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "action": { "default_title": "Open yt-fifo" }
}
